@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="ja">
    <head>
        <title>買い物メモアプリ</title>
        <link rel="stylesheet" href="style.css">
    </head>
    <body>
        <h1>買い物リスト</h1>
        <p>スーパーと薬局で買うもののメモです。</p>

        <h2>スーパー(夕食の材料)</h2>
        <p>カレーの材料を忘れずに安く買うこと。</p>

        <h2>薬局(日用品)</h2>

        <ul>
            <li>
                <label><input type="checkbox">にんじん</label>
            </li>
            <li>
                <label><input type="checkbox">ジャガイモ</label>
            </li>
            <li>
                <label><input type="checkbox">カレールー</label>
            </li>
        </ul>
        <ul>
            <!-- 複数の項目に同じクラスを付ける -->
            <li class="urgent">にんじん（特売！）</li>
            <li>じゃがいも</li>
            <li class="urgent">カレールー（絶対必要！）</li>
            
            <!-- ページ内で1つだけの特別な項目にIDを付ける -->
            <li id="special-item">ご褒美のケーキ</li>
        </ul>
    </body>
</html>
